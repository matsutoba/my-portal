# Go API（server/）が読む環境変数。
# Goプロセスはこのファイルを自動読み込みしない（godotenv等は未導入）。
# ローカルで使う場合は各自シェルでexportするか、`server/.env` を作って
# `set -a; source server/.env; set +a` してから `go run` すること。

# MySQL接続文字列。ローカルはdocker-compose.ymlの値に合わせる
DATABASE_URL=mysql://app:app@tcp(127.0.0.1:3306)/my_portal

# Ginサーバーのリッスンポート（未設定時は8080）
PORT=8080

# CORSで許可するフロントのオリジン（未設定時は http://localhost:3000）
ALLOWED_ORIGIN=http://localhost:3000

# GET/POST /api/books/sync の認可に使うベアラートークン。
# APIは公開URLで待ち受けるため、本番では必ず設定すること。
# 未設定の場合は認可チェック自体をスキップする（ローカル開発用の挙動）。
# cron実行元（サーバー上のcron等）から `Authorization: Bearer <値>` を
# 付けて呼び出すよう設定する。
CRON_SECRET=
